<UserControl x:Class="YMM4SoundNotifier.Settings.Views.SoundNotifierSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             xmlns:s="clr-namespace:YMM4SoundNotifier.Settings"
             d:DataContext="{d:DesignInstance s:SoundNotifierSettings}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="RowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style x:Key="SectionSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>

        <DataTemplate x:Key="TriggerTemplate" DataType="{x:Type s:TriggerSound}">
            <StackPanel>
                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="音を鳴らす" />
                    <c:ToggleSlider Grid.Column="1" HorizontalAlignment="Right"
                                    Value="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="音声ファイル" />
                    <c:FileSelector Grid.Column="1" HorizontalAlignment="Stretch"
                                    FileGroup="AudioItem" FileType="音声"
                                    AllowEmptyFilePath="True" ShowThumbnail="False"
                                    Value="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Style="{StaticResource RowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="音量" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <c:TextBoxSlider Width="200"
                                         Min="0" Max="100" DefaultMin="0" DefaultMax="100" Delta="1" DefaultValue="100" Unit="%" IsUnitVisible="True"
                                         Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="試聴" Width="80" Padding="8,2" Margin="4,0,0,0"
                                Tag="{Binding}" Click="OnPreviewClick" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Expander Header="全般" IsExpanded="True">
                <StackPanel>
                    <Grid Style="{StaticResource RowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="プラグインを有効にする" />
                        <c:ToggleSlider Grid.Column="1" HorizontalAlignment="Right"
                                        Value="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Style="{StaticResource RowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="全体の音量" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <c:TextBoxSlider Width="200"
                                             Min="0" Max="100" DefaultMin="0" DefaultMax="100" Delta="1" DefaultValue="100" Unit="%" IsUnitVisible="True"
                                             Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="停止" Width="80" Padding="8,2" Margin="4,0,0,0"
                                    Click="OnStopClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>
            <Separator Style="{StaticResource SectionSeparatorStyle}" />

            <Expander Header="起動時" IsExpanded="False">
                <StackPanel>
                    <ContentControl Content="{Binding Startup}"
                                    ContentTemplate="{StaticResource TriggerTemplate}" />
                </StackPanel>
            </Expander>
            <Expander Header="終了時" IsExpanded="False">
                <StackPanel>
                    <ContentControl Content="{Binding Shutdown}"
                                    ContentTemplate="{StaticResource TriggerTemplate}" />
                </StackPanel>
            </Expander>
            <Separator Style="{StaticResource SectionSeparatorStyle}" />

            <Expander Header="プロジェクト保存時" IsExpanded="False">
                <StackPanel>
                    <ContentControl Content="{Binding ProjectSaved}"
                                    ContentTemplate="{StaticResource TriggerTemplate}" />
                </StackPanel>
            </Expander>
            <Expander Header="プロジェクト保存失敗時" IsExpanded="False">
                <StackPanel>
                    <ContentControl Content="{Binding ProjectSaveFailed}"
                                    ContentTemplate="{StaticResource TriggerTemplate}" />
                </StackPanel>
            </Expander>
            <Separator Style="{StaticResource SectionSeparatorStyle}" />

            <Expander Header="動画出力完了時" IsExpanded="False">
                <StackPanel>
                    <ContentControl Content="{Binding VideoOutputCompleted}"
                                    ContentTemplate="{StaticResource TriggerTemplate}" />
                </StackPanel>
            </Expander>
            <Expander Header="動画出力失敗時" IsExpanded="False">
                <StackPanel>
                    <ContentControl Content="{Binding VideoOutputFailed}"
                                    ContentTemplate="{StaticResource TriggerTemplate}" />
                </StackPanel>
            </Expander>
            <Separator Style="{StaticResource SectionSeparatorStyle}" />

            <Expander Header="無操作が続いたとき" IsExpanded="False">
                <StackPanel>
                    <ContentControl Content="{Binding Idle}"
                                    ContentTemplate="{StaticResource TriggerTemplate}" />

                    <Grid Style="{StaticResource RowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="検知方法" />
                        <c:EnumComboBox Grid.Column="1" HorizontalAlignment="Right" Width="280"
                                        EnumType="{x:Type s:IdleDetection}"
                                        Value="{Binding IdleDetection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Style="{StaticResource RowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="無操作と判定するまでの時間" />
                        <c:TextBoxSlider Grid.Column="1" HorizontalAlignment="Right" Width="200"
                                         Min="10" Max="7200" DefaultMin="10" DefaultMax="600" Delta="10" DefaultValue="300" Unit="秒" IsUnitVisible="True"
                                         Value="{Binding IdleThresholdSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Style="{StaticResource RowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="この時間ごとに繰り返す" />
                        <c:ToggleSlider Grid.Column="1" HorizontalAlignment="Right"
                                        Value="{Binding IsIdleRepeated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
